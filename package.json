{
  "name": "von",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter=@usevon/dashboard",
    "dev:site": "turbo dev --filter=@usevon/site",
    "dev:docs": "turbo dev --filter=@usevon/docs",
    "dev:api": "turbo dev --filter=@usevon/api --filter=@usevon/worker",
    "build": "turbo run build --filter=@usevon/site... --filter=@usevon/dashboard... --filter=@usevon/api... --filter=@usevon/worker...",
    "build:docs": "turbo run build --filter=@usevon/docs...",
    "start": "turbo run start --filter=!@usevon/cli --filter=!@usevon/sdk",
    "db:migrate": "bun --env-file=.env run --filter @usevon/db db:migrate",
    "db:generate": "bun --env-file=.env run --filter @usevon/db db:generate",
    "db:push": "bun --env-file=.env run --filter @usevon/db db:push",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "test": "bun test packages/ apps/worker/ apps/api/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "shx": "^0.4.0",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "ultracite": "6.4.2"
  }
}