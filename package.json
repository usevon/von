{
  "name": "von",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun --env-file=.env turbo dev",
    "build": "bun --env-file=.env turbo run build --filter=@usevon/site... --filter=@usevon/dashboard... --filter=@usevon/api... --filter=@usevon/worker...",
    "start": "bun --env-file=.env turbo run start --filter=!@usevon/cli --filter=!@usevon/sdk",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome lint --write --unsafe .",
    "test:unit": "bun test packages/ apps/worker/ && bun run --cwd apps/api test tests/unit/",
    "test": "bun run test:unit",
    "test:integration": "bun run --cwd apps/api test:integration:auto"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "shx": "^0.4.0",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "ultracite": "6.4.2"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "@isaacs/brace-expansion": "^5.0.1",
    "minimatch": "^10.2.2"
  }
}
