{
  "name": "von",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun --env-file=.env turbo dev",
    "build": "bun --env-file=.env turbo run build --filter=@usevon/site... --filter=@usevon/dashboard...",
    "start": "bun --env-file=.env turbo run start --filter=!@usevon/cli --filter=!@usevon/sdk",
    "db:baseline": "cargo run --manifest-path services/Cargo.toml --bin von-migrate -- baseline",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome lint --write --unsafe .",
    "test:unit": "bun test packages/",
    "test": "bun run test:unit",
    "test:rust": "cargo test --manifest-path services/Cargo.toml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "shx": "^0.4.0",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "ultracite": "6.4.2"
  },
  "overrides": {
    "ioredis": "5.9.2",
    "lodash": "^4.17.23",
    "@isaacs/brace-expansion": "^5.0.1",
    "minimatch": "^10.2.2"
  }
}
