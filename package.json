{
  "name": "von",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:site": "turbo dev --filter=@usevon/site",
    "dev:docs": "turbo dev --filter=@usevon/docs",
    "dev:api": "turbo dev --filter=@usevon/api --filter=@usevon/worker",
    "build": "turbo run build --filter=@usevon/site... --filter=@usevon/dashboard... --filter=@usevon/api... --filter=@usevon/worker...",
    "build:docs": "turbo run build --filter=@usevon/docs...",
    "start": "turbo run start --filter=!@usevon/cli --filter=!@usevon/sdk",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "test": "bun test packages/ apps/worker/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "elysia": "^1.4.16",
    "shx": "^0.4.0",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "ultracite": "6.4.2"
  }
}
