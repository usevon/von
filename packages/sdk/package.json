      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsdown",
    "dev": "tsdown && tsdown --watch --no-clean",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.5",
    "elysia": "^1.4.16"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@usevon/api": "workspace:*",
    "@usevon/typescript-config": "workspace:*",
    "@usevon/utils": "workspace:*",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
