{
  "name": "@usevon/sdk",
  "version": "0.2.1",
  "description": "TypeScript SDK for Von webhooks",
  "license": "MIT",
  "author": "usevon",
  "repository": {
    "type": "git",
    "url": "https://github.com/usevon/von.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://usevon.com",
  "keywords": [
    "webhooks",
    "sdk",
    "typescript",
    "webhook-management",
    "api"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
