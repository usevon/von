{
  "name": "@usevon/react",
  "version": "0.1.0",
  "description": "React hooks and context provider for Von",
  "license": "MIT",
  "author": "usevon",
  "repository": {
    "type": "git",
    "url": "https://github.com/usevon/von.git",
    "directory": "packages/react"
  },
  "homepage": "https://usevon.com",
  "keywords": [
    "webhooks",
    "react",
    "hooks",
    "typescript",
