{
  "name": "@usevon/react",
  "version": "0.2.6",
  "description": "React hooks and context provider for Von",
  "license": "MIT",
  "author": "usevon",
  "repository": {
    "type": "git",
    "url": "https://github.com/usevon/von.git",
    "directory": "packages/react"
  },
  "homepage": "https://usevon.com",
  "keywords": [
    "webhooks",
    "react",
    "hooks",
    "typescript",
    "swr",
    "webhook-management"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "import": "./dist/hooks/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run tsdown",
    "dev": "tsdown && tsdown --watch --no-clean"
  },
  "dependencies": {
    "@usevon/auth": "workspace:*",
    "@usevon/types": "workspace:*",
    "swr": "^2.3.3"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@usevon/typescript-config": "workspace:*",
    "react": "^19.2.0",
    "tsdown": "^0.16.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
