{
  "name": "@usevon/ui",
  "version": "0.2.1",
  "private": true,
  "description": "Shared React components for Von",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "bun run tsdown",
    "dev": "tsdown --watch",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@base-ui/react": "^1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.23.26",
    "sugar-high": "^0.9.5",
    "tailwind-merge": ">=3.0.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@usevon/typescript-config": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "tsdown": "^0.16.8"
  }
