{
  "name": "@usevon/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components for Von - built on coss ui (Base UI + Tailwind)",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@usevon/typescript-config": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "tsdown": "^0.16.8",
    "typescript": "^5.7.2"
  }
}
