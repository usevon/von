{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react"],
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "style": {
        "noNamespace": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      }
    }
  }
}
