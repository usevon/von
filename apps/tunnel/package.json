{
  "name": "@usevon/tunnel-server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run tsdown",
    "build:prod": "bun build --compile --minify --sourcemap --drop console --drop debugger --target bun-linux-x64 --outfile dist/tunnel src/index.ts",
    "test": "bun test --preload ./tests/preload.ts",
    "test:unit": "bun test --preload ./tests/preload.ts tests/unit",
    "test:integration": "bun test --preload ./tests/preload.ts tests/integration"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@usevon/auth": "workspace:*",
    "@usevon/utils": "workspace:*",
    "@usevon/db": "workspace:*",
    "@usevon/queue": "workspace:*",
    "elysia": "^1.4.16"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.5",
    "@types/bun": "latest",
    "@usevon/typescript-config": "workspace:*",
    "tsdown": "^0.12.7",
    "typescript": "^5.7.2"
  }
}
