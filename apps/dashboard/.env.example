# Public URLs (client-side)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Better Auth (must match API's secrets)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long
API_KEY_SIGNING_SECRET=your-api-key-signing-secret-32chars

# Database (for server-side session validation)
DATABASE_URL=postgres://von:von_dev_password@localhost:5432/von_dev

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Turbo Remote Cache (optional)
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=your-base64-signature-key
# TURBO_TEAM=your-team-name
# TURBO_TOKEN=your-turbo-token
# TURBO_TELEMETRY_DISABLED=1
