NEXT_TELEMETRY_DISABLED=1

# Public URLs (client-side)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://von:von_dev_password@localhost:55432/von_dev

# Redis
REDIS_URL=redis://localhost:56379

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long
BETTER_AUTH_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3001
# Required in production (falls back to BETTER_AUTH_SECRET only in non-production)
# SECRET_ENCRYPTION_KEY=your-secret-encryption-key-min-32-characters
# API_KEY_SIGNING_SECRET=your-api-key-signing-secret

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Email (optional, logs to console when not configured)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Von <noreply@usevon.com>

# Turbo Remote Cache (optional)
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=your-base64-signature-key
# TURBO_TEAM=your-team-name
# TURBO_TOKEN=your-turbo-token
# TURBO_TELEMETRY_DISABLED=1
