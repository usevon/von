{
  "extends": "@usevon/typescript-config",
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["tests"]
}
