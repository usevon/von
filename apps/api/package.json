{
  "name": "@usevon/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify-whitespace --minify-syntax",
    "build:types": "tsc --emitDeclarationOnly && tsc-alias",
    "test": "bun test",
    "db:generate": "bun --env-file=.env run --filter @usevon/db db:generate",
    "db:migrate": "bun --env-file=.env run --filter @usevon/db db:migrate",
    "db:push": "bun --env-file=.env run --filter @usevon/db db:push",
    "db:studio": "bun --env-file=.env run --filter @usevon/db db:studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@usevon/auth": "workspace:*",
    "@usevon/db": "workspace:*",
    "@usevon/env": "workspace:*",
    "@usevon/logger": "workspace:*",
    "@usevon/queue": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@usevon/typescript-config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
