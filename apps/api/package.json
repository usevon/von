{
  "name": "@von/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "db:generate": "bun --env-file=.env run --filter @von/db db:generate",
    "db:migrate": "bun --env-file=.env run --filter @von/db db:migrate",
    "db:push": "bun --env-file=.env run --filter @von/db db:push",
    "db:studio": "bun --env-file=.env run --filter @von/db db:studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@von/auth": "workspace:*",
    "@von/db": "workspace:*",
    "@von/env": "workspace:*",
    "@von/logger": "workspace:*",
    "@von/queue": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@von/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
