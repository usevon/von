# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgres://von:von_dev_password@localhost:5432/von_dev

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long
BETTER_AUTH_URL=http://localhost:8080
# Required in production (falls back to BETTER_AUTH_SECRET only in non-production)
# SECRET_ENCRYPTION_KEY=your-secret-encryption-key-min-32-characters
# API_KEY_SIGNING_SECRET=your-api-key-signing-secret

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Dashboard URL (for CORS and trusted origins in development)
# DASHBOARD_URL=http://localhost:3001

# CORS (comma-separated origins, required in production)
# CORS_ORIGINS=https://app.usevon.com

# Tunnel
MAX_TUNNELS_PER_ORG=3
WEBHOOK_BATCH_MAX_EVENTS=100
MAX_ENDPOINT_IDS_PER_REQUEST=100

# Global API request limits
API_MAX_BODY_BYTES=1000000
API_MAX_URL_LENGTH=2048

# Email (optional — logs to console when not configured)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Von <noreply@usevon.com>
