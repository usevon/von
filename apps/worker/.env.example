# Server
NODE_ENV=development
WORKER_CONCURRENCY=50

# Retention cleanup
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_MS=3600000
EVENT_RETENTION_DAYS=90
DELIVERY_RETENTION_DAYS=90
INBOUND_DELIVERY_RETENTION_DAYS=90

# Database
DATABASE_URL=postgres://von:von_dev_password@localhost:5432/von_dev

# Redis
REDIS_URL=redis://localhost:6379

# Turbo Remote Cache (optional)
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=your-base64-signature-key
# TURBO_TEAM=your-team-name
# TURBO_TOKEN=your-turbo-token
# TURBO_TELEMETRY_DISABLED=1
