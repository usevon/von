# Server
NODE_ENV=development
WORKER_CONCURRENCY=50

# Retention cleanup
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_MS=3600000
EVENT_RETENTION_DAYS=90
DELIVERY_RETENTION_DAYS=90
INBOUND_DELIVERY_RETENTION_DAYS=90

# Auto-disable (disables endpoints after sustained circuit-open failures)
AUTO_DISABLE_ENABLED=true
AUTO_DISABLE_AFTER_DAYS=5
AUTO_DISABLE_CHECK_INTERVAL_MS=3600000

# Database
DATABASE_URL=postgres://von:von_dev_password@localhost:5432/von_dev

# Redis
REDIS_URL=redis://localhost:6379

# Email (optional, logs to console when not configured)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Von <noreply@usevon.com>
DASHBOARD_URL=http://localhost:3001
