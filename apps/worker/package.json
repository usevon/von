{
  "name": "@usevon/worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "build:prod": "bun build --compile --bytecode --minify --sourcemap --drop console --drop debugger --target bun-linux-x64 --outfile dist/worker src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@usevon/db": "workspace:*",
    "@usevon/email": "workspace:*",
    "@usevon/queue": "workspace:*",
    "@usevon/utils": "workspace:*",
    "bullmq": "^5.67.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.2",
    "postgres": "^3.4.7",
    "resend": "^4.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@usevon/typescript-config": "workspace:*"
  }
}
