NEXT_TELEMETRY_DISABLED=1

# Site URL (defaults to http://localhost:3000 if not set)
# Set to https://usevon.com in production
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dashboard app URL (defaults to http://localhost:3001 if not set)
# Set to https://app.usevon.com in production
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Docs URL (defaults to https://docs.usevon.com in llms route if not set)
# Set to your docs host in production
# NEXT_PUBLIC_DOCS_URL=http://localhost:3002

# Analytics (optional)
# Get your client ID from https://app.databuddy.cc/
# NEXT_PUBLIC_DATABUDDY_CLIENT_ID=your-client-id-here

# Turbo Remote Cache (optional)
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=your-base64-signature-key
# TURBO_TEAM=your-team-name
# TURBO_TOKEN=your-turbo-token
# TURBO_TELEMETRY_DISABLED=1
